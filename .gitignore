# Зависимости
node_modules/
.pnp/
.pnp.js

# Секреты и локальные настройки (токен бота храним ТОЛЬКО здесь, в репозиторий не попадает)
.env
.env.*
!.env.example
*.local

# Сборка и артефакты
dist/
build/
out/
.cache/
.vite/
.parcel-cache/

# Логи
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Локальные данные разработки (туннели, временные файлы)
.tmp/
tmp/
*.tmp
.ngrok/
*.sqlite
*.sqlite3

# Редакторы и IDE
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.swo

# Windows / macOS системный мусор
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store

# Локальные настройки Claude Code (командные правила в .claude/agents версионируем)
.claude/settings.local.json
# Исполнители сами дописывают сюда разрешения на разовые команды —
# вроде «погасить процесс номер 10380». Через час такого процесса уже нет,
# и в репозитории эта строка только мешает. Командные правила живут
# в .claude/agents, им ничего не грозит.
.claude/settings.json

# Следы браузера-робота, которым проверяют игру: сотни служебных логов и слепков страницы
.playwright-mcp/

# Скриншоты с проверок — доказательства для отчёта, но это картинки.
# Проект бинарные файлы не хранит: находки живут текстом в отчётах.
*.png
# Снимки экрана, которые делают оформитель и тестировщик. Их место — здесь,
# а не в корне: 10 сентября владелец увидел там шесть десятков картинок и
# справедливо спросил, почему в корне столько мусора. Папка вне git нарочно —
# снимки нужны на день работы, а не в истории проекта.
снимки/
# Служебные следы браузера-робота и временные папки.
.playwright-mcp/
*.jpg
*.jpeg
*.webp
# Исключение: картинки самой игры. Карточки витрины (img/витрина/) видит
# игрок, значит они обязаны уехать в публикацию — без этой строки git молча
# не брал бы их, и на телефоне вместо плиток были бы пустые места.
# Снимки проверок и эталоны по-прежнему вне git.
!img/**/*.jpg
# Предметы для броска — WebP с прозрачностью (в 6 раз легче PNG).
!img/**/*.webp
# И PNG самой игры — тоже исключение. 12 сентября владелец открыл нарды и
# сказал: «у меня нет самого поля». Причина была ровно здесь: правило *.png
# выше молча не пустило в публикацию доску, фишки и аватары из его набора,
# и на сайте вместо них были 404. SVG-кубики уехали, а PNG — нет.
# Правило про снимки проверок остаётся: их место в снимки/, а не в git.
!img/**/*.png
