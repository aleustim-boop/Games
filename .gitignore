# Зависимости
node_modules/
.pnp/
.pnp.js

# Секреты и локальные настройки (токен бота храним ТОЛЬКО здесь, в репозиторий не попадает)
.env
.env.*
!.env.example
*.local

# Сборка и артефакты
dist/
build/
out/
.cache/
.vite/
.parcel-cache/

# Логи
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Локальные данные разработки (туннели, временные файлы)
.tmp/
tmp/
*.tmp
.ngrok/
*.sqlite
*.sqlite3

# Редакторы и IDE
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.swo

# Windows / macOS системный мусор
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store

# Локальные настройки Claude Code (командные правила в .claude/agents версионируем)
.claude/settings.local.json
# Исполнители сами дописывают сюда разрешения на разовые команды —
# вроде «погасить процесс номер 10380». Через час такого процесса уже нет,
# и в репозитории эта строка только мешает. Командные правила живут
# в .claude/agents, им ничего не грозит.
.claude/settings.json

# Следы браузера-робота, которым проверяют игру: сотни служебных логов и слепков страницы
.playwright-mcp/

# Скриншоты с проверок — доказательства для отчёта, но это картинки.
# Проект бинарные файлы не хранит: находки живут текстом в отчётах.
*.png
*.jpg
*.jpeg
*.webp
