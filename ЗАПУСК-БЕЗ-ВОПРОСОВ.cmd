@echo off
chcp 65001 >nul
title Claude Code — режим без вопросов

rem  Запускает помощника сразу в режиме, где он НЕ СПРАШИВАЕТ разрешения
rem  на каждую команду. Двойной клик по этому файлу — и работа идёт без окон.
rem
rem  ЧТО ЭТО ЗНАЧИТ, ЧЕСТНО. В обычном режиме опасные команды (удаление файлов,
rem  запуск чужих программ, отправка в интернет) показывают окно «разрешить?».
rem  Здесь этих окон не будет вовсе. Это удобно и это же означает, что ошибка
rem  пройдёт молча — поэтому файл лежит отдельно, а не включён навсегда.
rem
rem  То же самое без файла: нажать Shift+Tab в уже запущенном окне и переключать
rem  режимы, пока не появится режим без вопросов.

cd /d "%~dp0"

echo.
echo   Запускаю помощника в режиме БЕЗ ВОПРОСОВ о разрешениях.
echo   Папка: %cd%
echo.
echo   Чтобы вернуться к обычному режиму — просто закройте это окно
echo   и запускайте claude как раньше.
echo.

claude --dangerously-skip-permissions

if errorlevel 1 (
  echo.
  echo   Не получилось запустить. Скорее всего команда claude не найдена.
  echo   Проверьте, что Claude Code установлен и открывается по слову claude.
  echo.
  pause
)
