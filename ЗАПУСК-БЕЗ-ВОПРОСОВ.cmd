@echo off
chcp 65001 >nul
title Claude Code — без вопросов о разрешениях

rem  ЧТО ЭТО. Запускает помощника в режиме, где он НЕ СПРАШИВАЕТ разрешения
rem  ни на одну команду. Двойной клик — и работа идёт без единого окна.
rem
rem  ПОЧЕМУ ФАЙЛОМ, А НЕ НАСТРОЙКОЙ. Помощник не может снять проверки сам себе —
rem  это запрещено намеренно, чтобы он не расширял себе права втихую. Поэтому
rem  режим включает владелец, своим действием: этим файлом.
rem
rem  ЧЕМ ЗА ЭТО ПЛАТЯТ, ЧЕСТНО. Окно «разрешить?» — последняя преграда перед
rem  удалением файлов, запуском чужих программ и отправкой в интернет. Здесь её
rem  не будет. Ошибка тоже пройдёт молча.
rem
rem  ТО ЖЕ БЕЗ ФАЙЛА: Shift+Tab в запущенном окне, листать до режима без вопросов.

cd /d "%~dp0"

echo.
echo   Запускаю помощника БЕЗ ВОПРОСОВ о разрешениях.
echo   Папка: %cd%
echo.
echo   Он сам прочитает ЗАДАЧИ.md и продолжит с того места, где остановились.
echo.

claude --permission-mode bypassPermissions "Прочитай ЗАДАЧИ.md — там записано, что в работе, что в очереди и с какой важностью. Продолжай работу с того места, на котором остановились: подними службы (сервер комнат на 8790, страницу игры на 8080, бота, туннель), проверь, что опубликовано на GitHub Pages, и запусти исполнителей по задачам уровня «горит» и «скоро». Обязательно заведи заново автообновление дашборда каждые 10 минут (CronCreate, расписание */10 * * * *): оно живёт только внутри сессии и при перезапуске пропадает. Адрес дашборда записан в шапке ЗАДАЧИ.md — обновляй его по тому же адресу, не заводя новый. Отчитывайся по-русски."

if errorlevel 1 (
  echo.
  echo   Первый способ не сработал — пробую второй.
  echo.
  claude --dangerously-skip-permissions "Прочитай ЗАДАЧИ.md и продолжай работу с того места, где остановились. Отчитывайся по-русски."
)

if errorlevel 1 (
  echo.
  echo   Не получилось запустить.
  echo   Проверьте, что Claude Code открывается по слову claude в обычном терминале.
  echo.
  pause
)
