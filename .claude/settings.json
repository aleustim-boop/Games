{
  "model": "opus",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"const д=new Date();console.log('[Часы] Сейчас '+д.toLocaleString('ru-RU',{day:'2-digit',month:'2-digit',hour:'2-digit',minute:'2-digit'}))\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "node D:/Claud/Games/.claude/hooks/начало-исполнителя.js"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node D:/Claud/Games/.claude/hooks/охрана-файлов.js"
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node D:/Claud/Games/.claude/hooks/разрешение-команд.js"
          },
          {
            "type": "command",
            "command": "node D:/Claud/Games/.claude/hooks/охрана-файлов.js"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node D:/Claud/Games/.claude/hooks/по-окончании-исполнителя.js"
          }
        ]
      }
    ]
  }
}
